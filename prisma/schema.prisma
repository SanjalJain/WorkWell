generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  HR
  MANAGER
  EMPLOYEE
  CLIENT
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentCategory {
  CONTRACT
  ID
  RESUME
  OTHER
}

enum ProjectType {
  FIXED
  TIME_AND_MATERIALS
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum ObjectiveLevel {
  COMPANY
  DEPARTMENT
  INDIVIDUAL
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ReviewType {
  SELF
  MANAGER
  PEER
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
}

enum FeedbackType {
  PUBLIC_KUDOS
  PRIVATE_FEEDBACK
}

enum ChecklistStatus {
  IN_PROGRESS
  COMPLETED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  employees           Employee[]
  departments         Department[]
  clients             Client[]
  projects            Project[]
  tasks               Task[]
  timeEntries         TimeEntry[]
  invoices            Invoice[]
  invoiceSequence     InvoiceSequence?
  leaveTypes          LeaveType[]
  publicHolidays      PublicHoliday[]
  reviewCycles        ReviewCycle[]
  objectives          Objective[]
  oneOnOnes           OneOnOne[]
  feedbacks           Feedback[]
  onboardingTemplates OnboardingTemplate[]
  onboardingChecklists OnboardingChecklist[]
  documents           Document[]
  auditLogs           AuditLog[]

  @@index([slug])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String?   @unique
  clientId       String?
  email          String
  passwordHash   String?
  role           Role      @default(EMPLOYEE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@index([clientId])
}

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  departmentId   String?
  managerId      String?
  firstName      String
  lastName       String
  jobTitle       String
  status         EmployeeStatus @default(ACTIVE)
  startDate      DateTime       @default(now()) @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager        Employee?       @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports        Employee[]      @relation("EmployeeHierarchy")
  user           User?
  compensations  Compensation[]
  leaveRequests  LeaveRequest[]
  documents      Document[]
  projectMemberships ProjectMember[]
  timeEntries    TimeEntry[]
  reviewsAsSubject Review[]      @relation("ReviewSubject")
  reviewsAsAuthor  Review[]      @relation("ReviewAuthor")
  oneOnOnesAsManager OneOnOne[]  @relation("OneOnOneManager")
  oneOnOnesAsReport  OneOnOne[]  @relation("OneOnOneReport")
  feedbacksSent    Feedback[]    @relation("FeedbackSender")
  feedbacksReceived Feedback[]   @relation("FeedbackReceiver")
  onboardingChecklists OnboardingChecklist[]
  ledProjects    Project[]       @relation("ProjectLead")
  assignedTasks  Task[]          @relation("TaskAssignee")
  ownedObjectives Objective[]    @relation("ObjectiveOwner")

  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Compensation {
  id           String    @id @default(cuid())
  employeeId   String
  hourlyCost   Decimal   @db.Decimal(10, 2)
  billableRate Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model LeaveType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  daysAllowance  Int      @default(20)
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@unique([organizationId, name])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  daysCount   Decimal     @db.Decimal(5, 1)
  status      LeaveStatus @default(PENDING)
  reason      String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  date           DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

model Document {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  name           String
  fileUrl        String
  category       DocumentCategory @default(OTHER)
  fileSize       Int?
  mimeType       String?
  uploadedAt     DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@index([organizationId, category])
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  billingAddress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  projects     Project[]
  invoices     Invoice[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  leadId         String?
  name           String
  type           ProjectType   @default(TIME_AND_MATERIALS)
  status         ProjectStatus @default(PLANNING)
  budget         Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead         Employee?       @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  tasks        Task[]
  timeEntries  TimeEntry[]
  keyResults   KeyResult[]

  @@index([organizationId, status])
  @@index([organizationId, clientId])
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  employeeId    String
  allocationPct Int      @default(100)
  role          String   @default("Member")
  createdAt     DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  projectId      String
  assigneeId     String?
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  estimateHours  Decimal    @default(0) @db.Decimal(6, 2)
  position       Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee        Employee?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  onboardingItems OnboardingItem[]

  @@index([organizationId, status])
  @@index([projectId, status, position])
  @@index([assigneeId])
}

model TimeEntry {
  id                String   @id @default(cuid())
  organizationId    String
  employeeId        String
  projectId         String
  invoiceLineItemId String?
  date              DateTime @db.Date
  hours             Decimal  @db.Decimal(5, 2)
  billable          Boolean  @default(true)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceLineItem InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([employeeId, date])
  @@index([projectId, invoiceLineItemId])
}

model InvoiceSequence {
  organizationId String   @id
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  total          Decimal       @default(0) @db.Decimal(12, 2)
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lineItems    InvoiceLineItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([clientId])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  hours       Decimal  @db.Decimal(6, 2)
  rate        Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([invoiceId])
}

model Objective {
  id             String         @id @default(cuid())
  organizationId String
  ownerId        String?
  parentId       String?
  title          String
  level          ObjectiveLevel @default(INDIVIDUAL)
  progress       Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Employee?    @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent       Objective?   @relation("ObjectiveHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Objective[]  @relation("ObjectiveHierarchy")
  keyResults   KeyResult[]

  @@index([organizationId, level])
  @@index([parentId])
}

model KeyResult {
  id           String   @id @default(cuid())
  objectiveId  String
  projectId    String?
  title        String
  startValue   Decimal  @default(0) @db.Decimal(10, 2)
  targetValue  Decimal  @db.Decimal(10, 2)
  currentValue Decimal  @default(0) @db.Decimal(10, 2)
  unit         String   @default("%")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([objectiveId])
  @@index([projectId])
}

model ReviewCycle {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  status         ReviewCycleStatus @default(DRAFT)
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@index([organizationId, status])
}

model Review {
  id          String       @id @default(cuid())
  cycleId     String
  subjectId   String
  authorId    String
  type        ReviewType
  status      ReviewStatus @default(DRAFT)
  content     Json?
  rating      Int?
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  cycle   ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subject Employee    @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author  Employee    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([cycleId, subjectId, authorId, type])
  @@index([cycleId, status])
  @@index([subjectId])
}

model OneOnOne {
  id             String   @id @default(cuid())
  organizationId String
  managerId      String
  reportId       String
  scheduledAt    DateTime
  status         String   @default("SCHEDULED")
  agenda         String?
  notes          String?
  actionItems    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager Employee @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)
  report  Employee @relation("OneOnOneReport", fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, scheduledAt])
  @@index([managerId, reportId])
}

model Feedback {
  id             String       @id @default(cuid())
  organizationId String
  fromId         String
  toId           String
  type           FeedbackType @default(PUBLIC_KUDOS)
  message        String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender   Employee @relation("FeedbackSender", fields: [fromId], references: [id], onDelete: Cascade)
  receiver Employee @relation("FeedbackReceiver", fields: [toId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
  @@index([toId])
}

model OnboardingTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        OnboardingTemplateItem[]
  checklists   OnboardingChecklist[]

  @@unique([organizationId, name])
}

model OnboardingTemplateItem {
  id                 String   @id @default(cuid())
  templateId         String
  title              String
  dayOffset          Int      @default(0)
  createsStarterTask Boolean  @default(false)
  createdAt          DateTime @default(now())

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model OnboardingChecklist {
  id             String          @id @default(cuid())
  organizationId String
  employeeId     String
  templateId     String
  status         ChecklistStatus @default(IN_PROGRESS)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  items        OnboardingItem[]

  @@unique([employeeId, templateId])
  @@index([organizationId, status])
}

model OnboardingItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  dueDate     DateTime  @db.Date
  completed   Boolean   @default(false)
  completedAt DateTime?
  taskId      String?
  createdAt   DateTime  @default(now())

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  task      Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([checklistId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  timestamp      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entity, timestamp])
  @@index([userId])
}
